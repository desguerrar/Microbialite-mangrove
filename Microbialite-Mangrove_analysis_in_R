#PERMANOVA pareado (POST-HOC ANALYSIS)

pairwise_permanova_manual <- function(dist_matrix, metadata, factor_col, permutations = 999) {
  # Ensure the factor_col is a valid column in metadata
  if (!factor_col %in% names(metadata)) {
    stop("The specified factor column does not exist in the metadata.")
  }
  
  # Convert the distance matrix to a matrix for easy subsetting
  dist_matrix <- as.matrix(MM2_wunifrac)
  
  # Extract the unique levels of the factor
  unique_groups <- unique(metadata[[factor_col]])
  
  # Initialize a list to store results
  results <- list()
  
  # Iterate over each pair of groups
  for (i in 1:(length(unique_groups) - 1)) {
    for (j in (i + 1):length(unique_groups)) {
      group1 <- unique_groups[i]
      group2 <- unique_groups[j]
      
      # Subset indices for the current pair of groups
      subset_indices <- metadata[[factor_col]] %in% c(group1, group2)
      subset_dist <- dist_matrix[subset_indices, subset_indices]
      subset_metadata <- metadata[subset_indices, ]
      
      # Check the subset
      print(paste("Comparing", group1, "vs", group2))
      print(table(subset_metadata[[factor_col]]))
      
      # Run PERMANOVA on the subset
      result <- tryCatch({
        adonis2(as.dist(subset_dist) ~ subset_metadata[[factor_col]], permutations = permutations)
      }, error = function(e) {
        list(error = TRUE, message = e)
      })
      
      # Store the result
      results[[paste(group1, "vs", group2)]] <- result
    }
  }
  
  return(results)
}

